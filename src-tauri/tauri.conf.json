{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "kterm",
  "version": "0.1.0",
  "identifier": "com.kterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "features": ["wry"]
  },
  "app": {
    "windows": [
      {
        "label": "win-1",
        "title": "kterm.exe - A scriptable terminal - win-1",
        "width": 1000,
        "height": 650,
        "resizable": true,
        "visible": false,
        "focus": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
